rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the judge (host) can create and update sessions.
    // Anyone can read public session data to sync the game phase.
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.hostUid;

      // Public seats: anyone authenticated can read (to choose a seat). Judge can write.
      match /seats/{seatId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid;
      }

      // Secret data: only the linked player or judge can read. Judge can write.
      match /secrets/{seatId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)/seats/$(seatId)).data.linkedUid ||
          request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid
        );
        allow write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid;
      }

      // Join requests allow players to request a specific seat.
      match /joinRequests/{uid} {
        function isHost() {
          return request.auth != null &&
            request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid;
        }

        function isValidPlayerRequest() {
          return request.auth != null && request.auth.uid == uid &&
            request.resource.data.uid == uid &&
            request.resource.data.seatId is string &&
            request.resource.data.displayName is string;
        }

        // Players can read their own request and create or retry it safely.
        allow read: if (request.auth != null && request.auth.uid == uid) || isHost();
        allow create, update: if isValidPlayerRequest();
        // The judge reviews and removes requests after approval or rejection.
        allow delete: if isHost();
      }

      // Action requests allow players to submit their votes or night actions.
      match /actionRequests/{requestId} {
        // Player can only create a request for themselves.
        allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
        // Player can read their own.
        allow read: if request.auth != null && request.auth.uid == resource.data.uid;
        // Host can read and delete all action requests.
        allow read, delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid;
      }
    }

    // Default users and other collections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
